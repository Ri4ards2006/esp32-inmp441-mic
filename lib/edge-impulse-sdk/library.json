{
  "name": "edge-impulse-sdk",
  "version": "1.0.0",
  "description": "Edge Impulse C++ Inference SDK and Trained Model",
  "build": {
    "flags": [
      "-I.",
      "-Imodel-parameters",
      "-Itflite-model",
      "-Iedge-impulse-sdk",
      "-Iedge-impulse-sdk/classifier",
      "-Iedge-impulse-sdk/porting",
      "-Iedge-impulse-sdk/porting/espressif/ESP-NN/include",
      "-Iedge-impulse-sdk/third_party/flatbuffers/include",
      "-Iedge-impulse-sdk/third_party/gemmlowp",
      "-Iedge-impulse-sdk/third_party/ruy"
    ],
    "srcFilter": [
      "+<tflite-model/*.cpp>",
      "+<edge-impulse-sdk/dsp/kissfft/*.cpp>",
      "+<edge-impulse-sdk/dsp/dct/*.cpp>",
      "+<edge-impulse-sdk/dsp/memory.cpp>",
      "+<edge-impulse-sdk/porting/espressif/*.cpp>",
      "+<edge-impulse-sdk/porting/espressif/ESP-NN/src/*/*_ansi.c>",
      "+<edge-impulse-sdk/porting/espressif/ESP-NN/src/*/*_opt.c>",
      "+<edge-impulse-sdk/classifier/ei_run_classifier_c.cpp>",
      "+<edge-impulse-sdk/tensorflow/lite/c/*.c>",
      "+<edge-impulse-sdk/tensorflow/lite/core/api/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/kernels/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/kernels/custom/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/kernels/internal/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/micro/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/micro/kernels/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/micro/memory_planner/*.cc>"
    ]
  }
}
